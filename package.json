{
  "name": "kinusty-volei",
  "version": "1.0.0",
  "description": "Sistema de matrículas, área do aluno e painel administrativo da Kinusty Volleyball",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --env-file-if-exists=.env.local server.js",
